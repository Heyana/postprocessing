"uniform vec2 texelSize; uniform float intensity; uniform float kernelSize; void mainImage(const in vec4 inputColor, const in vec2 uv, out vec4 outputColor) { vec4 center = texture2D(inputBuffer, uv); vec4 top = texture2D(inputBuffer, uv + vec2(0.0, -1.0) * texelSize * kernelSize); vec4 bottom = texture2D(inputBuffer, uv + vec2(0.0, 1.0) * texelSize * kernelSize); vec4 left = texture2D(inputBuffer, uv + vec2(-1.0, 0.0) * texelSize * kernelSize); vec4 right = texture2D(inputBuffer, uv + vec2(1.0, 0.0) * texelSize * kernelSize); vec4 laplacian = 4.0 * center - top - bottom - left - right; outputColor = center + laplacian * intensity; }" 
